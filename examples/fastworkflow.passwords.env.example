# FastWorkflow API keys
# Each key corresponds to an LLM role defined in fastworkflow.env.
# Copy this file to fastworkflow.passwords.env and fill in your keys.

LITELLM_API_KEY_SYNDATA_GEN=<your_api_key_here>
LITELLM_API_KEY_PARAM_EXTRACTION=<your_api_key_here>
LITELLM_API_KEY_RESPONSE_GEN=<your_api_key_here>
LITELLM_API_KEY_PLANNER=<your_api_key_here>
LITELLM_API_KEY_AGENT=<your_api_key_here>
LITELLM_API_KEY_CONVERSATION_STORE=<your_api_key_here>
