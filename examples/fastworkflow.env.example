# FastWorkflow LLM configuration
# Each variable specifies a LiteLLM model identifier for a specific role.
# See https://docs.litellm.ai/docs/providers for supported providers and model formats.

# --- Core LLM roles ---
# These control which LLM is used at each stage of FastWorkflow's processing pipeline.
# COMMAND_METADATA_GEN: generates command metadata (descriptions, parameter schemas)
# SYNDATA_GEN: generates synthetic training utterances for command routing
# PARAM_EXTRACTION: extracts structured parameters from user messages
# RESPONSE_GEN: generates natural-language responses to the user
# PLANNER: plans multi-step workflows
# AGENT: the main execution agent that reasons, selects tools, and drives the conversation
# CONVERSATION_STORE: summarizes and stores conversation context

LLM_SYNDATA_GEN=groq/openai/gpt-oss-20b
LLM_PARAM_EXTRACTION=groq/openai/gpt-oss-20b
LLM_RESPONSE_GEN=groq/openai/gpt-oss-20b
LLM_PLANNER=groq/openai/gpt-oss-20b
LLM_AGENT=groq/openai/gpt-oss-20b
LLM_CONVERSATION_STORE=groq/openai/gpt-oss-20b

# --- FastWorkflow internal settings ---
# These control synthetic data generation, caching, and error handling behavior.
# SPEEDDICT_FOLDERNAME: folder name for cached workflow context data (speeddict persistence)
# SYNTHETIC_UTTERANCE_GEN_*: hyperparameters for generating synthetic training utterances
# *_ERRMSG / NOT_FOUND / INVALID: templates for error messages returned by parameter
# extraction when user input is missing, invalid, or unrecognized.

SPEEDDICT_FOLDERNAME=___workflow_contexts
SYNTHETIC_UTTERANCE_GEN_NUMOF_PERSONAS=4
SYNTHETIC_UTTERANCE_GEN_UTTERANCES_PER_PERSONA=5
SYNTHETIC_UTTERANCE_GEN_PERSONAS_PER_BATCH=1
MISSING_INFORMATION_ERRMSG="Missing parameter values: "
INVALID_INFORMATION_ERRMSG="Invalid parameter values: "
NOT_FOUND="NOT_FOUND"
INVALID="INVALID"
PARAMETER_EXTRACTION_ERROR_MSG="Error in parameter extraction: {error}"
