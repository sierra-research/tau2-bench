# Required: tokenizer-only directory, full model directory, or Hugging Face repo ID
# matching the model served by the endpoint. Local model weights are not required.
TOKENIZER_PATH=/path/to/matching-tokenizer-only
# TRUST_REMOTE_CODE=1
# Optional: set this only when not using the experiment's uv environment.
# PYTHON_BIN=/path/to/python

# OpenAI-compatible inference endpoint and served model name. BASE_URL may be a
# server root, a URL ending in /v1, or a complete /chat/completions endpoint.
BASE_URL=http://127.0.0.1:9019
MODEL_NAME=model

# Optional Bearer authentication. API_KEY_ENV names the variable containing the
# secret. Copy this template to <tau2-bench>/.env; never put a real key here.
API_KEY_ENV=BENCHMARK_API_KEY
BENCHMARK_API_KEY=

# Record the actual route used for this run. Examples: direct, company-vpn.
# This does not switch the VPN; it only prevents unlike paths being silently mixed.
NETWORK_LABEL=unspecified

# Local vLLM deployments normally expose Prometheus counters. Override the URL if
# needed. Hosted endpoints such as OpenRouter usually need DISABLE_METRICS=1.
# METRICS_URL=http://127.0.0.1:9019/metrics
DISABLE_METRICS=0

# Provider-specific request fields, forwarded as a JSON object. Values are never
# stored in the report; only top-level field names are recorded. OpenRouter example:
# REQUEST_EXTRA_JSON='{"provider":{"order":["<provider-slug>"]},"reasoning":{"enabled":false}}'

# Optional benchmark settings.
CONCURRENCY=4,8,12,16
SYSTEM_PROMPT_TOKENS=4500
PROMPT_TOKEN_BUCKETS=4000,6000,8000,10000,12288,16384
MIN_SAMPLES_PER_BUCKET=128
MAX_TURNS_PER_USER=80
CONVERSATION_POOL_MULTIPLIER=7
SHARED_SYSTEM_RATIO=0.8
MAX_OUTPUT_TOKENS=64
REQUEST_TIMEOUT=900
MAX_CONSECUTIVE_FAILED_WAVES=3

# Optional report destination. The default is:
# <tau2-bench>/data/exp/token_cache_benchmark/<run-id>/
# OUTPUT_DIR=/path/to/reports
