{
  "dashboard": {
    "title": "tau2-bench Health Dashboard",
    "description": "LLM observability dashboard for tau2-bench-agent evaluations",
    "layout_type": "ordered",
    "template_variables": [
      {
        "name": "domain",
        "default": "*",
        "prefix": "domain"
      },
      {
        "name": "env",
        "default": "production",
        "prefix": "env"
      }
    ],
    "widgets": [
      {
        "id": "header",
        "title": "",
        "type": "note",
        "content": "# tau2-bench LLM Observability\n\nReal-time monitoring of agent benchmark evaluations powered by Gemini 2.0 Flash",
        "background_color": "blue",
        "font_size": "16",
        "text_align": "center"
      },
      {
        "id": "pass-rate-by-domain",
        "title": "Task Pass Rate by Domain",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:tau2.task.success{success:true,$domain,$env} by {domain}.as_rate() / sum:tau2.task.success{$domain,$env} by {domain}.as_rate() * 100",
            "display_type": "line",
            "style": {
              "palette": "dog_classic"
            }
          }
        ],
        "yaxis": {
          "min": "0",
          "max": "100",
          "label": "Pass Rate %"
        }
      },
      {
        "id": "avg-reward-trend",
        "title": "Average Task Reward Trend",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:tau2.task.reward{$domain,$env} by {domain}",
            "display_type": "line"
          }
        ],
        "yaxis": {
          "min": "0",
          "max": "1"
        },
        "markers": [
          {
            "value": "y = 0.7",
            "display_type": "error dashed",
            "label": "Quality Threshold"
          }
        ]
      },
      {
        "id": "token-usage",
        "title": "LLM Token Usage",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:tau2.llm.tokens_input{$domain,$env}.as_count()",
            "display_type": "bars",
            "style": {
              "palette": "cool"
            }
          },
          {
            "q": "sum:tau2.llm.tokens_output{$domain,$env}.as_count()",
            "display_type": "bars",
            "style": {
              "palette": "warm"
            }
          }
        ]
      },
      {
        "id": "error-rate",
        "title": "Task Error Rate",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:tau2.task.error_count{$domain,$env}.as_rate()",
            "display_type": "line",
            "style": {
              "palette": "red"
            }
          }
        ]
      },
      {
        "id": "termination-reasons",
        "title": "Task Termination Reasons",
        "type": "sunburst",
        "requests": [
          {
            "q": "sum:tau2.termination{$domain,$env} by {reason}.as_count()"
          }
        ]
      },
      {
        "id": "latency-percentiles",
        "title": "Task Duration Percentiles",
        "type": "timeseries",
        "requests": [
          {
            "q": "p50:tau2.task.duration_seconds{$domain,$env}",
            "display_type": "line"
          },
          {
            "q": "p90:tau2.task.duration_seconds{$domain,$env}",
            "display_type": "line"
          },
          {
            "q": "p99:tau2.task.duration_seconds{$domain,$env}",
            "display_type": "line"
          }
        ],
        "markers": [
          {
            "value": "y = 60",
            "display_type": "warning dashed",
            "label": "SLO Limit (60s)"
          }
        ]
      },
      {
        "id": "active-cases",
        "title": "Active Cases",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:case_management.cases.open{service:tau2-bench}",
            "aggregator": "last"
          }
        ],
        "precision": 0,
        "autoscale": true,
        "custom_unit": "cases"
      },
      {
        "id": "active-incidents",
        "title": "Active Incidents",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:incident_management.incidents.active{service:tau2-bench}",
            "aggregator": "last"
          }
        ],
        "precision": 0,
        "autoscale": true,
        "custom_unit": "incidents"
      },
      {
        "id": "slo-status",
        "title": "Task Success Rate SLO",
        "type": "slo",
        "slo_id": "tau2-bench-task-success-rate-slo",
        "show_error_budget": true,
        "view_type": "detail",
        "time_windows": ["7d", "30d"]
      },
      {
        "id": "tool-calls-breakdown",
        "title": "Tool Calls by Type",
        "type": "toplist",
        "requests": [
          {
            "q": "sum:tau2.tool.calls{$domain,$env} by {tool_name,requestor}.as_count()"
          }
        ]
      },
      {
        "id": "nl-assertion-pass-rate",
        "title": "NL Assertion Pass Rate",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:tau2.assertion.result{type:nl,met:true,$domain,$env}.as_count() / sum:tau2.assertion.result{type:nl,$domain,$env}.as_count() * 100",
            "aggregator": "avg"
          }
        ],
        "precision": 1,
        "autoscale": false,
        "custom_unit": "%",
        "conditional_formats": [
          {
            "comparator": ">=",
            "value": 90,
            "palette": "green_on_white"
          },
          {
            "comparator": ">=",
            "value": 70,
            "palette": "yellow_on_white"
          },
          {
            "comparator": "<",
            "value": 70,
            "palette": "red_on_white"
          }
        ]
      },
      {
        "id": "reward-distribution",
        "title": "Task Reward Distribution",
        "type": "heatmap",
        "requests": [
          {
            "q": "avg:tau2.task.reward{$domain,$env} by {task_id,domain}"
          }
        ]
      },
      {
        "id": "recent-failures",
        "title": "Recent Task Failures",
        "type": "log_stream",
        "query": "service:tau2-bench-agent event:tau2.task.failed $domain $env",
        "columns": ["task_id", "domain", "reward", "termination_reason"],
        "message_display": "expanded-md",
        "sort": {
          "column": "timestamp",
          "order": "desc"
        }
      },
      {
        "id": "gemini-traces",
        "title": "LLM Observability - Recent Gemini Calls",
        "type": "trace_stream",
        "query": "service:tau2-bench-agent @ml.app:tau2-bench-agent",
        "columns": ["Duration", "Operation", "Model", "Tokens"],
        "sort": {
          "column": "timestamp",
          "order": "desc"
        }
      }
    ]
  }
}
