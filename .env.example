ANTHROPIC_API_KEY=<your_key_here>
OPENAI_API_KEY=<your_key_here>
ELEVENLABS_API_KEY=<your_key_here>
DEEPGRAM_API_KEY=<your_key_here>
# Required for `tau2 judges suite` (speech-fidelity judge) and Gemini Live agents
GEMINI_API_KEY=<your_key_here>
# Required only for xAI voice agents
XAI_API_KEY=<your_key_here>
# Required only for hosted Avartha agents (--audio-native-provider avartha_pipecat).
# AVARTHA_API_KEY=<your_key_here>
# Required only for Phonic voice agents
PHONIC_API_KEY=<your_key_here>

# Required only for Pine's OpenAI-compatible realtime models (pine-*).
PINE_API_KEY=<your_key_here>
PINE_REALTIME_BASE_URL=<your_realtime_websocket_url_here>

# Required for banking_knowledge qwen_embeddings* retrieval configs (via OpenRouter)
OPENROUTER_API_KEY=<your_key_here>

# ── Voice Persona Overrides ────────────────────────────────────────────
# The default voice IDs are Sierra-internal and won't work for external users.
# Create your own voices with:
#   python -m tau2.voice.scripts.setup_voices --language all
# It prints one TAU2_VOICE_ID_<LANG>_<PERSONA> line per pack persona to paste
# here. See docs/voice-personas.md for details.
#
# TAU2_VOICE_ID_EN_MAMADOU_DIALLO=<your_voice_id>
# TAU2_VOICE_ID_EN_PRIYA_PATIL=<your_voice_id>
# TAU2_VOICE_ID_ES_ALEJANDRO_ES_V1=<your_voice_id>
# TAU2_VOICE_ID_ES_CAMILA_ES_V1=<your_voice_id>
# TAU2_VOICE_ID_HI_RISHIKA_HINDI_V1=<your_voice_id>
# TAU2_VOICE_ID_HI_IMRAN_HINDI_V1=<your_voice_id>
# TAU2_VOICE_ID_KO_JIHUN_KO_V1=<your_voice_id>
# TAU2_VOICE_ID_KO_SOYEON_KO_V1=<your_voice_id>
# TAU2_VOICE_ID_PT_RICARDO_PT_V1=<your_voice_id>
# TAU2_VOICE_ID_PT_JULIANA_PT_V1=<your_voice_id>
# TAU2_VOICE_ID_ZH_JIANGUO_ZH_V1=<your_voice_id>
# TAU2_VOICE_ID_ZH_XIAOMENG_ZH_V1=<your_voice_id>
