  "procedures": {
    "D0120": {
      "cdt_code": "D0120",
      "description": "Periodic oral evaluation",
      "benefit_class": "A",
      "limitations": "Oral evaluations limited to two per calendar year."
    },
    "D0210": {
      "cdt_code": "D0210",
      "description": "Full mouth radiographic images",
      "benefit_class": "A",
      "limitations": "Full mouth and panoramic images combined: once every 3 calendar years."
    },
    "D0274": {
      "cdt_code": "D0274",
      "description": "Bitewings, four images",
      "benefit_class": "A",
      "limitations": "Twice per calendar year age 22 and younger; once per calendar year age 23 and older."
    },
    "D1110": {
      "cdt_code": "D1110",
      "description": "Prophylaxis (cleaning), adult",
      "benefit_class": "A",
      "limitations": "Standard: twice per calendar year. High: three per calendar year."
    },
    "D1120": {
      "cdt_code": "D1120",
      "description": "Prophylaxis (cleaning), child",
      "benefit_class": "A",
      "limitations": "Twice per calendar year."
    },
    "D1206": {
      "cdt_code": "D1206",
      "description": "Topical fluoride varnish",
      "benefit_class": "A",
      "limitations": "Covered persons under age 22, twice per calendar year."
    },
    "D1351": {
      "cdt_code": "D1351",
      "description": "Sealant, per tooth",
      "benefit_class": "A",
      "limitations": "Covered persons under 18, unrestored permanent molars only, one per tooth every 3 calendar years."
    },
    "D2391": {
      "cdt_code": "D2391",
      "description": "Resin-based composite filling, one surface, posterior",
      "benefit_class": "B",
      "limitations": "One restoration per tooth surface every 2 calendar years."
    },
    "D2930": {
      "cdt_code": "D2930",
      "description": "Prefabricated stainless steel crown, primary tooth",
      "benefit_class": "B",
      "limitations": "One per tooth per lifetime, covered persons under 15."
    },
    "D2740": {
      "cdt_code": "D2740",
      "description": "Crown, porcelain/ceramic",
      "benefit_class": "C",
      "limitations": "Only when needed for extensive decay or fracture; replacement only after 5 years. A lower-cost alternative benefit may apply."
    },
    "D2950": {
      "cdt_code": "D2950",
      "description": "Core buildup",
      "benefit_class": "C",
      "limitations": "Only with evidence of insufficient retention for a crown."
    },
    "D3330": {
      "cdt_code": "D3330",
      "description": "Root canal, molar",
      "benefit_class": "C",
      "limitations": "Once per tooth per lifetime; retreatment only 12 months after the prior root canal."
    },
    "D4341": {
      "cdt_code": "D4341",
      "description": "Periodontal scaling and root planing, four or more teeth per quadrant",
      "benefit_class": "B",
      "limitations": "Once per quadrant every 2 calendar years."
    },
    "D4910": {
      "cdt_code": "D4910",
      "description": "Periodontal maintenance",
      "benefit_class": "B",
      "limitations": "Only after active periodontal treatment; with cleanings, four combined per calendar year."
    },
    "D6010": {
      "cdt_code": "D6010",
      "description": "Surgical placement of implant body",
      "benefit_class": "C",
      "limitations": "Implant services limited to $2,500 per person per year ($2,000 Standard out-of-network); replacement after 5 years."
    },
    "D7140": {
      "cdt_code": "D7140",
      "description": "Extraction, erupted tooth",
      "benefit_class": "B",
      "limitations": "None beyond plan maximums."
    },
    "D8080": {
      "cdt_code": "D8080",
      "description": "Comprehensive orthodontic treatment, adolescent",
      "benefit_class": "D",
      "limitations": "Only to treat malocclusion; not for mild-moderate crowding; not covered if the appliance was placed before coverage began."
    },
    "D8090": {
      "cdt_code": "D8090",
      "description": "Comprehensive orthodontic treatment, adult",
      "benefit_class": "D",
      "limitations": "Only to treat malocclusion; not for mild-moderate crowding; not covered if the appliance was placed before coverage began."
    },
    "D9944": {
